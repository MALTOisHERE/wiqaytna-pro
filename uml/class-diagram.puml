@startuml Wiqaytna_Pro_Class_Diagram
!theme plain
title Wiqaytna Pro - Class Diagram

' Enumerations
enum UserRole {
  DOCTOR
  PATIENT
  ASSISTANT
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

' Base User class
class User {
  - id: Long
  - email: String
  - password: String
  - role: UserRole
  - firstName: String
  - lastName: String
  - phone: String
  - createdAt: Timestamp
  - updatedAt: Timestamp
  - isActive: Boolean
  __
  + register(): void
  + login(): String
  + logout(): void
  + updateProfile(): void
}

' Doctor class
class Doctor {
  - id: Long
  - userId: Long
  - specialization: String
  - licenseNumber: String
  - cabinetAddress: String
  - bio: String
  - consultationFee: Decimal
  - yearsOfExperience: Integer
  - createdAt: Timestamp
  __
  + getAvailability(): List<TimeSlot>
  + addTimeSlot(TimeSlot): void
  + removeTimeSlot(Long): void
  + getAppointments(): List<Appointment>
  + updateAppointmentStatus(Long, Status): void
}

' Patient class
class Patient {
  - id: Long
  - userId: Long
  - dateOfBirth: Date
  - medicalHistory: String
  - bloodGroup: String
  - allergies: String
  - createdAt: Timestamp
  __
  + searchDoctors(String): List<Doctor>
  + bookAppointment(Long, Date, Time): Appointment
  + getMyAppointments(): List<Appointment>
  + cancelAppointment(Long): void
  + getMedicalHistory(): String
}

' TimeSlot class
class TimeSlot {
  - id: Long
  - doctorId: Long
  - dayOfWeek: Integer
  - startTime: Time
  - endTime: Time
  - isAvailable: Boolean
  - createdAt: Timestamp
  __
  + isAvailable(): Boolean
  + setAvailability(Boolean): void
  + overlaps(TimeSlot): Boolean
}

' Appointment class
class Appointment {
  - id: Long
  - doctorId: Long
  - patientId: Long
  - appointmentDate: Date
  - appointmentTime: Time
  - status: AppointmentStatus
  - notes: String
  - reminderSent: Boolean
  - createdAt: Timestamp
  - updatedAt: Timestamp
  - createdBy: Long
  __
  + schedule(): void
  + confirm(): void
  + cancel(): void
  + complete(): void
  + sendReminder(): void
  + updateNotes(String): void
}

' Service layer classes
class UserService {
  + register(UserDTO): User
  + authenticate(String, String): String
  + getUserByEmail(String): User
  + updateUser(Long, UserDTO): User
  + deleteUser(Long): void
}

class DoctorService {
  + createDoctor(DoctorDTO): Doctor
  + getDoctorById(Long): Doctor
  + searchDoctors(String): List<Doctor>
  + updateDoctor(Long, DoctorDTO): Doctor
  + getDoctorTimeSlots(Long): List<TimeSlot>
}

class PatientService {
  + createPatient(PatientDTO): Patient
  + getPatientById(Long): Patient
  + updatePatient(Long, PatientDTO): Patient
  + getPatientAppointments(Long): List<Appointment>
}

class AppointmentService {
  + createAppointment(AppointmentDTO): Appointment
  + getAppointmentById(Long): Appointment
  + updateAppointmentStatus(Long, Status): Appointment
  + cancelAppointment(Long): void
  + getDoctorAppointments(Long, Date): List<Appointment>
  + sendReminders(): void
}

class TimeSlotService {
  + createTimeSlot(TimeSlotDTO): TimeSlot
  + getAvailableSlots(Long, Integer): List<TimeSlot>
  + updateTimeSlot(Long, TimeSlotDTO): TimeSlot
  + deleteTimeSlot(Long): void
}

' Repository layer classes
interface UserRepository {
  + findById(Long): Optional<User>
  + findByEmail(String): Optional<User>
  + save(User): User
  + deleteById(Long): void
}

interface DoctorRepository {
  + findById(Long): Optional<Doctor>
  + findBySpecialization(String): List<Doctor>
  + findByUserId(Long): Optional<Doctor>
  + save(Doctor): Doctor
}

interface PatientRepository {
  + findById(Long): Optional<Patient>
  + findByUserId(Long): Optional<Patient>
  + save(Patient): Patient
}

interface AppointmentRepository {
  + findById(Long): Optional<Appointment>
  + findByDoctorId(Long): List<Appointment>
  + findByPatientId(Long): List<Appointment>
  + findByDoctorIdAndDate(Long, Date): List<Appointment>
  + save(Appointment): Appointment
}

interface TimeSlotRepository {
  + findById(Long): Optional<TimeSlot>
  + findByDoctorId(Long): List<TimeSlot>
  + findByDoctorIdAndDayOfWeek(Long, Integer): List<TimeSlot>
  + save(TimeSlot): TimeSlot
  + deleteById(Long): void
}

' Relationships

' User composition relationships
User "1" o-- "0..1" Doctor : has profile >
User "1" o-- "0..1" Patient : has profile >

' User with UserRole
User -- UserRole : uses >

' Doctor relationships
Doctor "1" -- "*" TimeSlot : defines >
Doctor "1" -- "*" Appointment : receives >

' Patient relationships
Patient "1" -- "*" Appointment : books >

' Appointment relationships
Appointment -- AppointmentStatus : has >
Appointment "*" -- "1" Doctor : scheduled with >
Appointment "*" -- "1" Patient : booked by >

' Service to Entity relationships
UserService ..> User : manages >
DoctorService ..> Doctor : manages >
PatientService ..> Patient : manages >
AppointmentService ..> Appointment : manages >
TimeSlotService ..> TimeSlot : manages >

' Service to Repository relationships (Dependency Injection)
UserService ..> UserRepository : uses >
DoctorService ..> DoctorRepository : uses >
PatientService ..> PatientRepository : uses >
AppointmentService ..> AppointmentRepository : uses >
TimeSlotService ..> TimeSlotRepository : uses >

' Repository to Entity relationships
UserRepository ..> User : persists >
DoctorRepository ..> Doctor : persists >
PatientRepository ..> Patient : persists >
AppointmentRepository ..> Appointment : persists >
TimeSlotRepository ..> TimeSlot : persists >

note top of User
  Base class for all user types.
  Role determines if user is
  Doctor, Patient, or Assistant
end note

note top of Doctor
  Doctors can manage their schedule
  and view appointments
end note

note top of Patient
  Patients can book appointments
  and view medical history
end note

note top of Appointment
  Core entity linking doctors
  and patients with scheduling info
end note

note right of UserService
  Service layer implements
  business logic following
  SOLID principles
end note

note right of UserRepository
  Repository layer handles
  data persistence using
  JPA/Hibernate
end note

@enduml
