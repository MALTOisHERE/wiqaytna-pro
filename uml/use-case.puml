@startuml Wiqaytna_Pro_UseCase_Colored
' --- CONFIGURATION DU STYLE ---
skinparam backgroundColor white
skinparam handwritten false
skinparam shadow true
skinparam roundCorner 10

' Couleurs des Acteurs
skinparam actor {
    BackgroundColor #E3F2FD
    BorderColor #2C3E50
    FontName Arial
}

' Couleurs des Cas d'Utilisation (Usecases)
skinparam usecase {
    BackgroundColor white
    BorderColor #2C3E50
    ArrowColor #2C3E50
}

skinparam package {
    BackgroundColor #F9F9F9
    BorderColor #DDDDDD
    FontColor #666666
}

title Wiqaytna Pro - Use Case Diagram (Structured)

' --- ACTEURS ---
actor :Patient: as patient #BBDEFB
actor :Doctor: as doctor #C8E6C9
actor :Assistant: as assistant #FFF9C4

' --- SYSTEME ---
rectangle "Wiqaytna Pro System" {

    ' Groupe 1: Accès (Violet)
    package "1. Authentification & Sécurité" {
        usecase "Register Account" as register #E1BEE7
        usecase "Login" as login #E1BEE7
        usecase "Logout" as logout #E1BEE7
    }

    ' Groupe 2: Actions Patient (Bleu)
    package "2. Espace Patient" {
        usecase "Search Doctors" as searchDoctors #BBDEFB
        usecase "View Doctor Profile" as viewDoctorProfile #BBDEFB
        usecase "View Available Slots" as viewSlots #BBDEFB
        usecase "Book Appointment" as bookAppointment #BBDEFB
        usecase "View My Appointments" as viewMyAppointments #BBDEFB
        usecase "Cancel Appointment" as cancelAppointment #BBDEFB
        usecase "Receive SMS Reminder" as receiveReminder #BBDEFB
    }

    ' Groupe 3: Actions Médicales (Vert)
    package "3. Gestion Médicale (Docteur/Assistant)" {
        usecase "Manage Time Slots" as manageSlots #C8E6C9
        usecase "View Appointments" as viewAppointments #C8E6C9
        usecase "View Patient History" as viewPatientHistory #C8E6C9
        usecase "Update Status\n(Confirm/Complete)" as updateStatus #C8E6C9
        usecase "View Calendar" as viewCalendar #C8E6C9
        usecase "Handle Walk-in" as handleWalkIn #FFF9C4
    }
}

' --- SYSTÈME EXTERNE ---
rectangle "External Services" #F5F5F5 {
    usecase "Send SMS API" as sendSMS #E0E0E0
}

' --- RELATIONS ---

' Authentification (Tous)
patient -up-> register
patient -up-> login
doctor -up-> login
assistant -up-> login

' Patient Flow
patient --> searchDoctors
patient --> bookAppointment
patient --> viewMyAppointments
patient --> cancelAppointment

' Relations logiques Patient
searchDoctors ..> viewDoctorProfile : <<extend>>
bookAppointment ..> viewSlots : <<include>>
bookAppointment ..> receiveReminder : <<include>>
receiveReminder ..> sendSMS : <<uses>>

' Doctor Flow
doctor --> manageSlots
doctor --> viewAppointments
doctor --> viewPatientHistory
doctor --> updateStatus
doctor --> viewCalendar

' Assistant Flow
assistant --> viewAppointments
assistant --> handleWalkIn
assistant --> updateStatus

@enduml