@startuml Wiqaytna_Pro_Sequence_Reminder_Colored
' --- STYLE ET CONFIGURATION ---
skinparam backgroundColor white
skinparam handwritten false
skinparam shadow true
skinparam roundCorner 10
skinparam sequenceMessageAlign center
skinparam maxMessageSize 160

' Couleurs
skinparam sequence {
    ArrowColor #2C3E50
    LifeLineBorderColor #666666
    LifeLineBackgroundColor white
    ParticipantBorderColor #666666
}

title Wiqaytna Pro - Processus de Rappel SMS Automatique

actor "Patient" as Patient #E0E0E0

box "Déclencheur (Cron)" #F3E5F5
    participant "Scheduler\n(Spring)" as Scheduler #E1BEE7
end box

box "Logique Métier" #F1F8E9
    participant "Appointment\nService" as Service #C8E6C9
    participant "SMS\nService" as SMSService #C8E6C9
end box

box "Données (Persistance)" #FFFDE7
    participant "Appointment\nRepo" as AppointmentRepo #FFF9C4
    database "PostgreSQL\nDatabase" as DB #CFD8DC
end box

' --- DÉBUT DU FLUX ---
== Exécution Planifiée (Chaque Heure) ==

activate Scheduler #E1BEE7
note over Scheduler
  @Scheduled(cron = "0 0 * * * *")
  Vérifie les RDV toutes les heures
end note

Scheduler -> Service: sendUpcomingReminders()
activate Service #C8E6C9

note right of Service
  Cible: RDV dans les prochaines 24h
  sans rappel envoyé (reminder_sent = false)
end note

Service -> AppointmentRepo: findUpcomingAppointments()
activate AppointmentRepo #FFF9C4

AppointmentRepo -> DB: SELECT complex JOIN
activate DB #CFD8DC
note right of DB
  JOIN appointments, doctors, patients
  WHERE date = DEMAIN
  AND status IN (SCHEDULED, CONFIRMED)
end note
DB --> AppointmentRepo: Liste RDV à rappeler
deactivate DB

AppointmentRepo --> Service: List<Appointment>
deactivate AppointmentRepo

== Traitement Unitaire ==

loop Pour chaque RDV trouvé

    Service -> Service: Préparer le message SMS
    
    Service -> SMSService: sendSMS(phone, message)
    activate SMSService #C8E6C9

    alt Environnement DEV (Mock)
        SMSService -> SMSService: Log dans la console
        note right of SMSService
          [MOCK] Envoi au +212...
          "Rappel: RDV demain à 11h..."
        end note
        SMSService --> Service: Succès (Simulé)
    
    else Environnement PROD (API Réelle)
        SMSService -> SMSService: Appel API (ex: Octopush)
        SMSService --> Service: Succès / Échec
    end
    
    deactivate SMSService

    alt Si SMS envoyé avec succès
        Service -> AppointmentRepo: updateReminderSent(id, true)
        activate AppointmentRepo #FFF9C4
        
        AppointmentRepo -> DB: UPDATE reminder_sent = TRUE
        activate DB #CFD8DC
        DB --> AppointmentRepo: OK
        deactivate DB
        
        AppointmentRepo --> Service: Confirmé
        deactivate AppointmentRepo
        
    else Si échec d'envoi
        Service -> Service: Log d'erreur (Retry plus tard)
    end

end

Service --> Scheduler: Fin du traitement
deactivate Service
deactivate Scheduler

== Réception ==

note over Patient
  Reçoit le SMS 24h avant
end note

Patient -> Patient: Lit le SMS
Patient -> Patient: Clic lien Annulation (Optionnel)

@enduml
