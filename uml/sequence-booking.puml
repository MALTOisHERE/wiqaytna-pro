@startuml Wiqaytna_Pro_Sequence_Colored
' --- STYLE ET CONFIGURATION ---
skinparam backgroundColor white
skinparam handwritten false
skinparam shadow true
skinparam roundCorner 10
skinparam sequenceMessageAlign center
skinparam maxMessageSize 150

' Couleurs des flèches et activations
skinparam sequence {
    ArrowColor #2C3E50
    LifeLineBorderColor #666666
    LifeLineBackgroundColor white
    ParticipantBorderColor #666666
}

title Wiqaytna Pro - Processus de Réservation (Sequence Diagram)

' --- DÉFINITION DES ACTEURS ET PARTICIPANTS GROUPÉS ---

actor "Patient" as Patient #E0E0E0

box "Présentation (Client)" #F5F5F5
    participant "Frontend\n(React)" as Frontend #E3F2FD
end box

box "Logique Métier (Backend)" #F1F8E9
    participant "Appt\nController" as Controller #E1BEE7
    participant "Appt\nService" as Service #C8E6C9
    participant "TimeSlot\nService" as TimeSlotService #C8E6C9
    participant "SMS\nService" as SMSService #C8E6C9
end box

box "Persistance (Données)" #FFFDE7
    participant "Doctor\nRepo" as DoctorRepo #FFF9C4
    participant "Appt\nRepo" as AppointmentRepo #FFF9C4
    database "PostgreSQL\nDatabase" as DB #CFD8DC
end box

' --- 1. RECHERCHE DE MÉDECINS ---
== 1. Recherche de Médecins ==

Patient -> Frontend: Recherche (Spécialité: Dentiste)
activate Frontend #E3F2FD

Frontend -> Controller: GET /api/doctors
activate Controller #E1BEE7

Controller -> Service: searchDoctors("Dentiste")
activate Service #C8E6C9

Service -> DoctorRepo: findBySpecialization
activate DoctorRepo #FFF9C4

DoctorRepo -> DB: SQL SELECT query
activate DB #CFD8DC
DB --> DoctorRepo: Liste Docteurs
deactivate DB

DoctorRepo --> Service: List<Doctor>
deactivate DoctorRepo

Service --> Controller: List<DoctorDTO>
deactivate Service

Controller --> Frontend: JSON Response
deactivate Controller

Frontend --> Patient: Affiche la liste
deactivate Frontend

' --- 2. CONSULTATION DES CRÉNEAUX ---
== 2. Consultation des Disponibilités ==

Patient -> Frontend: Choisit un médecin
activate Frontend #E3F2FD

Frontend -> Controller: GET /slots (Date, DoctorID)
activate Controller #E1BEE7

Controller -> TimeSlotService: getAvailableSlots()
activate TimeSlotService #C8E6C9

' Récupération des créneaux théoriques
TimeSlotService -> DoctorRepo: getTimeSlots()
activate DoctorRepo #FFF9C4
DoctorRepo -> DB: SELECT time_slots
activate DB #CFD8DC
DB --> DoctorRepo: Result
deactivate DB
DoctorRepo --> TimeSlotService: Tous les créneaux
deactivate DoctorRepo

' Récupération des RDV déjà pris
TimeSlotService -> AppointmentRepo: getExistingAppts()
activate AppointmentRepo #FFF9C4
AppointmentRepo -> DB: SELECT appointments
activate DB #CFD8DC
DB --> AppointmentRepo: Result
deactivate DB
AppointmentRepo --> TimeSlotService: RDV existants
deactivate AppointmentRepo

TimeSlotService -> TimeSlotService: Filtrage (Retrait des créneaux occupés)

TimeSlotService --> Controller: Créneaux Libres
deactivate TimeSlotService

Controller --> Frontend: JSON Response
deactivate Controller

Frontend --> Patient: Affiche les horaires
deactivate Frontend

' --- 3. RÉSERVATION ---
== 3. Confirmation du Rendez-vous ==

Patient -> Frontend: Confirme le créneau
activate Frontend #E3F2FD

Frontend -> Controller: POST /appointments
activate Controller #E1BEE7

Controller -> Service: createAppointment()
activate Service #C8E6C9

' Double validation
Service -> TimeSlotService: isSlotAvailable?
activate TimeSlotService #C8E6C9
TimeSlotService -> AppointmentRepo: countExisting()
activate AppointmentRepo #FFF9C4
AppointmentRepo -> DB: SELECT COUNT
activate DB #CFD8DC
DB --> AppointmentRepo: 0 (Libre)
deactivate DB
AppointmentRepo --> TimeSlotService: False (Pas pris)
deactivate AppointmentRepo
TimeSlotService --> Service: True (Dispo)
deactivate TimeSlotService

' Sauvegarde
Service -> AppointmentRepo: save(Appointment)
activate AppointmentRepo #FFF9C4
AppointmentRepo -> DB: INSERT INTO appointments
activate DB #CFD8DC
DB --> AppointmentRepo: OK
deactivate DB
AppointmentRepo --> Service: Appointment Created
deactivate AppointmentRepo

' Notification
Service -> SMSService: sendConfirmation()
activate SMSService #C8E6C9
note right of SMSService
  Envoi SMS au +212...
  "RDV confirmé le 15/01 à 11h"
end note
SMSService --> Service: OK
deactivate SMSService

Service --> Controller: DTO (Succès)
deactivate Service

Controller --> Frontend: 201 Created
deactivate Controller

Frontend --> Patient: Affiche confirmation
deactivate Frontend

@enduml