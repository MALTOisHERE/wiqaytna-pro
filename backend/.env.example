# Server Configuration
SERVER_PORT=8080

# Database Configuration
# PostgreSQL connection details
DB_HOST=localhost
DB_PORT=5432
DB_NAME=wiqaytna_db
DB_USERNAME=postgres
DB_PASSWORD=your_database_password_here

# JPA/Hibernate Configuration
# Options: create, create-drop, update, validate, none
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true
JPA_FORMAT_SQL=true

# JWT Configuration
# IMPORTANT: Generate a strong random secret key for production (minimum 256 bits)
# You can generate one using: openssl rand -base64 64
JWT_SECRET=your_jwt_secret_key_here_minimum_256_bits
JWT_EXPIRATION=86400000

# CORS Configuration
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:3001


# Logging Configuration
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=DEBUG
LOG_LEVEL_SECURITY=DEBUG
LOG_LEVEL_SQL=DEBUG

# SMS Service Configuration
SMS_ENABLED=false
SMS_MOCK_MODE=true

# Scheduler Configuration
# Cron expression: runs every hour at minute 0
SCHEDULER_REMINDER_ENABLED=true
SCHEDULER_REMINDER_CRON=0 0 * * * *

# File Upload Configuration
MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=10MB
