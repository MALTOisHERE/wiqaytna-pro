# API Configuration
# Backend API base URL (without trailing slash)
VITE_API_BASE_URL=http://localhost:8080/api

# Application Configuration
VITE_APP_NAME=Wiqaytna Pro
VITE_APP_VERSION=1.0.0

# Development Configuration
# Port for development server (Vite default is 5173, but we use 3000)
VITE_DEV_PORT=3000

# Feature Flags
# Enable/disable features without code changes
VITE_ENABLE_SMS_NOTIFICATIONS=false
VITE_ENABLE_EMAIL_NOTIFICATIONS=false

# Appointment Configuration
# Number of days in advance users can book appointments
VITE_APPOINTMENT_BOOKING_ADVANCE_DAYS=30
# Minimum hours before appointment that cancellation is allowed
VITE_APPOINTMENT_CANCELLATION_HOURS=24

# UI Configuration
# Timezone for date/time display
VITE_DEFAULT_TIMEZONE=Africa/Casablanca
# Date format: DD/MM/YYYY (European) or MM/DD/YYYY (US)
VITE_DATE_FORMAT=DD/MM/YYYY
# Time format: HH:mm (24-hour) or hh:mm A (12-hour with AM/PM)
VITE_TIME_FORMAT=HH:mm
